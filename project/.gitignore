Resources/json/user_config.json

# Local/temporary output
/output/
/docs/
Resources/.backup/
.git.vs-invalid-backup_*
.git.vs-invalid-backup_*/

# Vendored external dependencies required for local Visual Studio builds.
!externals/
!externals/SDL2/
!externals/SDL2/include/
!externals/SDL2/include/**
!externals/SDL2/lib/
!externals/SDL2/lib/**
!externals/assimp/
!externals/assimp/include/
!externals/assimp/include/**
!externals/assimp/lib/
!externals/assimp/lib/**
!externals/nlohmann/
!externals/nlohmann/**

# Exclude unused vendored binary variants.
externals/SDL2/lib/x86/
externals/SDL2/lib/x64/SDL2.dll
externals/SDL2/lib/x64/SDL2.lib
externals/SDL2/lib/x64/SDL2main.lib
externals/SDL2/lib/x64/SDL2test.lib
externals/assimp/lib/Debug/*.pdb
externals/assimp/lib/Debug/assimp-vc143-mdd.lib
externals/assimp/lib/Release/assimp-vc143-md.lib

# Bundled local tools that are too large for normal Git pushes
Resources/tools/Blender 4.4/
