# Editor cinematic camera gizmo model.
# Forward direction is -Z in the engine view, so the lens points toward the camera target side.
mtllib camera_gizmo.mtl

o camera_body
usemtl camera_body
v -0.700 -0.400  0.350
v  0.700 -0.400  0.350
v  0.700  0.400  0.350
v -0.700  0.400  0.350
v -0.700 -0.400 -0.350
v  0.700 -0.400 -0.350
v  0.700  0.400 -0.350
v -0.700  0.400 -0.350
f 1 2 3 4
f 5 8 7 6
f 1 5 6 2
f 2 6 7 3
f 3 7 8 4
f 4 8 5 1

o camera_handle
usemtl camera_accent
